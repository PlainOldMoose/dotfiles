// Tokyo Night
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "source": "arch_small", "color": { "1": "blue" }, "padding": { "top": 1, "right": 3 } },
  "display": { "separator": "  ", "color": { "keys": "blue", "title": "magenta" } },
  "modules": [
    "break",
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "os",       "key": "", "keyColor": "blue" },
    { "type": "kernel",   "key": "", "keyColor": "blue" },
    { "type": "packages", "key": "󰏗", "keyColor": "cyan" },
    { "type": "shell",    "key": "", "keyColor": "cyan" },
    { "type": "wm",       "key": "", "keyColor": "magenta" },
    { "type": "terminal", "key": "", "keyColor": "magenta" },
    { "type": "cpu",      "key": "", "keyColor": "yellow" },
    { "type": "gpu",      "key": "󰍛", "keyColor": "yellow" },
    { "type": "memory",   "key": "", "keyColor": "green" },
    { "type": "uptime",   "key": "󰅐", "keyColor": "green" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
